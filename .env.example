# Server-only. Never rename these to NEXT_PUBLIC_*.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional text inference providers. No automatic provider failover occurs.
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional task-specific classification provider.
HF_TOKEN=
HF_TEXT_CLASSIFICATION_MODEL=unitary/toxic-bert

# Optional URL reputation sources. Do not use VirusTotal Public API for commercial use.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_API_TIER=public
URLSCAN_API_KEY=

# Optional authorized Instagram Graph API Business Discovery connection.
# Requires an eligible professional account, approved app permissions, and token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Local single-instance persistence. Use Docker with a persistent /app/.data volume.
# Do not run multiple app instances against this JSON store.
