"use client";

import React, { useState, useEffect } from "react";
import Link from "next/link";
import { Button } from "@/components/ui/button";
import { 
  ArrowLeft, 
  Download, 
  Share2, 
  AlertTriangle, 
  Shield, 
  User,
  Bot, 
  MessageSquare, 
  ExternalLink,
  CheckCircle,
  XCircle,
  AlertCircle,
  CircleAlert,
  Loader2,
  BrainCircuit,
  HeartPulse
} from "lucide-react";

export default function ResultsPage() {
  const [showShareModal, setShowShareModal] = useState(false);
  const [downloadStarted, setDownloadStarted] = useState(false);
  const [isLoading, setIsLoading] = useState(false); // Set to false since we're using hardcoded data
  
  // Get current date formatted as "September 5, 2025"
  const getCurrentDate = () => {
    const date = new Date();
    return date.toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric' 
    });
  };
  
  // Hardcoded scan results
  const scanResults = {
    profileName: "@john_smith92",
    scanDate: getCurrentDate(),
    overallScore: 70,
    riskLevel: "Medium",
    categories: [
      { 
        name: "Identity Likelihood",
        score: 70,
        level: "High",
        description: "Profile likely belongs to a real person",
        details: "Claimed to be a lawyer but post history shows inconsistent professional knowledge. Location information varies between different posts. Writing style varies significantly between platforms."
      },
      { 
        name: "Toxicity Level", 
        score: 40,
        level: "Medium",
        description: "Some concerning language detected",
        details: "Analysis found 3 instances of toxic language in the content."
      },
      { 
        name: "Mental Health Signals", 
        score: 40,
        level: "Concerning",
        description: "Signs of potential mental health distress detected",
        details: "Found 3 indicators of potential mental health distress."
      },
      { 
        name: "Bot Likelihood", 
        score: 90,
        level: "Very Low",
        description: "Highly likely to be human-operated",
        details: "Posting patterns, response times, and content variation strongly indicate human behavior."
      },
      { 
        name: "Account Risk Score", 
        score: 65,
        level: "Medium",
        description: "Medium risk profile - Some concerns",
        details: "This assessment combines identity verification (70%) and content safety (40%) metrics."
      }
    ],
    evidenceSnippets: [
      // Toxicity evidence
      {
        category: "Toxicity",
        snippet: "Why do people think it's okay to send threatening messages to strangers? Get a life.",
        source: "Twitter Reply, Aug 28",
        severity: "Medium"
      },
      {
        category: "Toxicity",
        snippet: "Can't believe how stupid some people are. If you don't understand basic science, maybe just keep quiet?",
        source: "Twitter Post, Aug 27",
        severity: "Medium"
      },
      {
        category: "Toxicity",
        snippet: "Are you seriously that dense? The answer is right in front of your face but you're too stubborn to see it.",
        source: "Reddit Comment, Aug 25",
        severity: "High"
      },
      // Mental health evidence
      {
        category: "Mental Health",
        snippet: "Feeling really down today. Sometimes I wonder if anyone would even notice if I just disappeared.",
        source: "Twitter Post, Aug 24",
        severity: "High"
      },
      {
        category: "Mental Health",
        snippet: "Seriously considering deleting all my social media accounts and just disappearing. Too much toxicity.",
        source: "Twitter Post, Aug 22",
        severity: "Medium"
      },
      {
        category: "Mental Health",
        snippet: "I've been struggling with similar thoughts. Some days are just harder than others, but we have to keep going.",
        source: "Reddit Comment, Aug 21",
        severity: "Medium"
      },
      // Identity evidence
      {
        category: "Identity",
        snippet: "Claimed to be a lawyer but post history shows inconsistent professional knowledge",
        source: "Cross-platform Analysis",
        severity: "Medium"
      },
      {
        category: "Identity",
        snippet: "Profile photo matches LinkedIn profile and company website staff page",
        source: "Cross-reference",
        severity: "Positive"
      },
      {
        category: "Identity Verification",
        snippet: "Location information varies between different posts",
        source: "Data Mismatch",
        severity: "Medium"
      },
      {
        category: "Harassment",
        snippet: "Repeated comments on same user's posts with increasing hostility",
        source: "Pattern Analysis",
        severity: "Medium"
      }
    ],
    recommendations: [
      "Proceed with caution due to occasional toxic language",
      "Verify identity through video chat before meeting",
      "Cross-check professional claims with other sources",
      "Be aware of some inconsistencies in personal details",
      "Consider suggesting mental health resources if interaction continues"
    ]
  };

  // Helper function to determine color based on score
  const getScoreColor = (score: number): string => {
    if (score >= 80) return "text-purple-600";
    if (score >= 60) return "text-pink-500";
    return "text-red-500";
  };

  // Handle download report button click
  const handleDownload = () => {
    setDownloadStarted(true);
    
    // Simulate download completion
    setTimeout(() => {
      setDownloadStarted(false);
    }, 2000);
  };

  // Mental health alert component
  const MentalHealthAlert = () => {
    // Only show if mental health signals are concerning
    const shouldShow = scanResults.categories.some(cat => 
      cat.name === "Mental Health Signals" && cat.level === "Concerning"
    );
    
    if (!shouldShow) return null;
    
    return (
      <div className="bg-purple-50 border-l-4 border-purple-500 p-4 my-4 rounded-r">
        <div className="flex">
          <div className="flex-shrink-0">
            <HeartPulse className="h-5 w-5 text-purple-500" />
          </div>
          <div className="ml-3">
            <h3 className="text-sm font-medium text-purple-800">Mental Health Alert</h3>
            <div className="mt-2 text-sm text-purple-700">
              <p>
                This profile shows potential signs of mental health distress. If you're engaging with this person:
              </p>
              <ul className="list-disc pl-5 mt-2 space-y-1">
                <li>Respond with empathy and avoid judgmental language</li>
                <li>Don't make assumptions about their mental state</li>
                <li>Consider sharing mental health resources if appropriate</li>
                <li>Remember you're not responsible for their wellbeing</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    );
  };

  return (
    <div className="max-w-7xl mx-auto px-4 py-8">
      {/* Back button */}
      <div className="mb-6">
        <Link href="/scan">
          <Button variant="ghost" className="text-purple-600 hover:text-purple-800 hover:bg-purple-50 p-0">
            <ArrowLeft className="mr-2 h-4 w-4" /> Back to Scan
          </Button>
        </Link>
      </div>
      
      {/* Share modal */}
      {showShareModal && (
        <div className="fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-lg max-w-md w-full p-6 relative">
            <button 
              className="absolute right-4 top-4 text-gray-500 hover:text-gray-700"
              onClick={() => setShowShareModal(false)}
            >
              <XCircle className="h-6 w-6" />
            </button>
            
            <h2 className="text-xl font-bold text-purple-900 mb-4">Share Safety Report</h2>
            <p className="text-gray-600 mb-6">Share these insights with someone else</p>
            
            <div className="space-y-6">
              <div className="flex gap-3">
                <Button 
                  className="flex-1 bg-purple-600 hover:bg-purple-700 text-white"
                  onClick={() => {
                    alert("Report shared via message!");
                    setShowShareModal(false);
                  }}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  Message
                </Button>
                <Button 
                  className="flex-1 bg-purple-600 hover:bg-purple-700 text-white"
                  onClick={() => {
                    alert("Report shared via email!");
                    setShowShareModal(false);
                  }}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                  Email
                </Button>
              </div>
            </div>
            
            <div className="border-t border-purple-100 pt-4">
              <p className="text-sm text-purple-700 mb-3">Or copy link:</p>
              <div className="flex">
                <input 
                  type="text" 
                  value="https://truesight.ai/report/12345" 
                  readOnly
                  className="flex-1 rounded-l-lg border border-r-0 border-purple-200 px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-purple-400 bg-purple-50 text-purple-800"
                />
                <Button 
                  className="rounded-l-none bg-purple-600 hover:bg-purple-700 text-white"
                  onClick={() => {
                    navigator.clipboard.writeText("https://truesight.ai/report/12345");
                    alert("Link copied to clipboard!");
                  }}
                >
                  Copy
                </Button>
              </div>
            </div>
          </div>
        </div>
      )}
      
      {/* Main content */}
      <div className="bg-white rounded-xl shadow-lg overflow-hidden">
        {/* Header */}
        <div className="bg-gradient-to-r from-purple-500 to-pink-500 px-6 md:px-8 py-4">
          <div className="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
            <div>
              <h1 className="text-2xl md:text-3xl font-bold mb-2 text-white">Safety Report: <span className="text-purple-100">{scanResults.profileName}</span></h1>
              <p className="text-purple-100">Scan completed on {scanResults.scanDate}</p>
            </div>
            <div className="flex gap-2">
              <Button 
                variant="outline" 
                className="bg-white/10 text-white border-white/20 hover:bg-white/20"
                onClick={handleDownload}
                disabled={downloadStarted}
              >
                {downloadStarted ? (
                  <>
                    <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                    Downloading...
                  </>
                ) : (
                  <>
                    <Download className="mr-2 h-4 w-4" />
                    Download Report
                  </>
                )}
              </Button>
              <Button 
                variant="outline" 
                className="bg-white/10 text-white border-white/20 hover:bg-white/20"
                onClick={() => setShowShareModal(true)}
              >
                <Share2 className="mr-2 h-4 w-4" />
                Share
              </Button>
            </div>
          </div>
        </div>
        
        {/* Results */}
        <div className="px-6 md:px-8 py-6">
          {/* Overall score */}
          <div className="mb-8">
            <h2 className="text-xl font-bold text-purple-900 mb-4">Overall Safety Score</h2>
            
            <div className="flex flex-col md:flex-row gap-6">
              <div className="flex-shrink-0">
                <div className="relative">
                  <div className="h-28 w-28 rounded-full border-8 border-purple-200 bg-gradient-to-br from-purple-100 to-pink-100 flex items-center justify-center shadow-lg">
                    <span className="text-3xl font-bold bg-gradient-to-r from-purple-700 to-pink-600 text-transparent bg-clip-text">{scanResults.overallScore}</span>
                  </div>
                  <div className={`absolute -bottom-2 right-0 px-3 py-1 rounded-full text-sm font-medium shadow-md
                    ${scanResults.riskLevel === "Low" ? "bg-purple-100 text-purple-800" : 
                      scanResults.riskLevel === "Medium" ? "bg-pink-100 text-pink-800" : 
                      scanResults.riskLevel === "Loading" ? "bg-purple-100 text-purple-800" :
                      "bg-red-100 text-red-800"}`}
                  >
                    {scanResults.riskLevel} {scanResults.riskLevel !== "Loading" ? "Risk" : ""}
                  </div>
                </div>
              </div>
              
              <div>
                <MentalHealthAlert />
                
                <h3 className="text-lg font-semibold text-purple-900 mb-2">Summary</h3>
                <p className="text-gray-700 mb-4">
                  This profile has been analyzed across multiple dimensions including identity verification, 
                  content toxicity, and behavior patterns. The profile presents a {scanResults.riskLevel.toLowerCase()} 
                  risk overall, with some areas of concern highlighted below.
                </p>
                
                <div className="flex flex-wrap gap-3">
                  <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                    <Shield className="mr-1 h-4 w-4" />
                    Identity: {scanResults.categories.find(c => c.name === "Identity Likelihood")?.level || "Medium"}
                  </span>
                  <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-pink-100 text-pink-800">
                    <AlertTriangle className="mr-1 h-4 w-4" />
                    Toxicity: {scanResults.categories.find(c => c.name === "Toxicity Level")?.level || "Medium"}
                  </span>
                  <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                    <Bot className="mr-1 h-4 w-4" />
                    Bot: {scanResults.categories.find(c => c.name === "Bot Likelihood")?.level || "Low"}
                  </span>
                  <span className="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-pink-100 text-pink-800">
                    <HeartPulse className="mr-1 h-4 w-4" />
                    Mental Health: {scanResults.categories.find(c => c.name === "Mental Health Signals")?.level || "Low Risk"}
                  </span>
                </div>
              </div>
            </div>
          </div>
          
          {/* Categories */}
          <div className="mb-8">
            <h2 className="text-xl font-bold text-purple-900 mb-4">Detailed Analysis</h2>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {scanResults.categories.map((category, index) => (
                <div key={index} className="border border-purple-100 rounded-lg p-4 bg-white">
                  <h3 className="text-lg font-semibold text-purple-900 mb-2">{category.name}</h3>
                  
                  <div className="flex items-center mb-3">
                    <div className="w-full bg-gray-200 rounded-full h-2.5 mr-2">
                      <div 
                        className={`h-2.5 rounded-full ${
                          category.score >= 80 ? "bg-purple-600" : 
                          category.score >= 60 ? "bg-pink-500" : 
                          "bg-red-500"
                        }`} 
                        style={{ width: `${category.score}%` }}
                      ></div>
                    </div>
                    <span className={`text-sm font-medium ${getScoreColor(category.score)}`}>{category.score}</span>
                  </div>
                  
                  <p className="text-gray-800 font-medium mb-1">{category.description}</p>
                  <p className="text-gray-600 text-sm">{category.details}</p>
                </div>
              ))}
            </div>
          </div>
          
          {/* Recommendations */}
          <div className="mb-8">
            <h2 className="text-xl font-bold text-purple-900 mb-4">Safety Recommendations</h2>
            
            <div className="bg-purple-50 rounded-lg p-4">
              <ul className="space-y-2">
                {scanResults.recommendations.map((recommendation, index) => (
                  <li key={index} className="flex items-start">
                    <div className="flex-shrink-0 mt-1">
                      <CheckCircle className="h-5 w-5 text-purple-600" />
                    </div>
                    <p className="ml-3 text-gray-700">{recommendation}</p>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          
          {/* Evidence */}
          <div>
            <h2 className="text-xl font-bold text-purple-900 mb-4">Evidence Snippets</h2>
            
            <div className="space-y-4">
              {scanResults.evidenceSnippets.map((evidence, index) => (
                <div key={index} className="border border-purple-100 rounded-lg p-4">
                  <div className="flex flex-wrap items-start gap-2 mb-2">
                    <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-medium
                      ${evidence.category === "Toxicity" ? "bg-pink-100 text-pink-800" : 
                        evidence.category === "Mental Health" ? "bg-purple-100 text-purple-800" : 
                        "bg-blue-100 text-blue-800"}`}
                    >
                      {evidence.category}
                    </span>
                    <span className={`inline-flex items-center px-2 py-1 rounded text-xs font-medium
                      ${evidence.severity === "High" ? "bg-red-100 text-red-800" : 
                        evidence.severity === "Medium" ? "bg-yellow-100 text-yellow-800" : 
                        evidence.severity === "Low" ? "bg-green-100 text-green-800" : 
                        "bg-green-100 text-green-800"}`}
                    >
                      {evidence.severity}
                    </span>
                    <span className="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800">
                      {evidence.source}
                    </span>
                  </div>
                  
                  <div className="p-3 bg-gray-50 rounded border border-gray-100">
                    <p className="text-gray-800">{evidence.snippet}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
