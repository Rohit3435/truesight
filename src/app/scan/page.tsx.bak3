"use client";

import React, { useState } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { ArrowLeft, Upload, Link2, User, Globe, Loader2, AlertCircle, Shield, Search, Lock, CheckCircle } from "lucide-react";
import Link from "next/link";
import { useRouter } from "next/navigation";
import { motion } from "framer-motion";
import { Card } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";

export default function ScanPage() {
  const [name, setName] = useState("");
  const [link, setLink] = useState("");
  const [platform, setPlatform] = useState("");
  const [isConsent, setIsConsent] = useState(false);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [error, setError] = useState("");
  const router = useRouter();

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setError("");

    // Basic validation
    if (!name.trim()) {
      setError("Please enter a name or username");
      return;
    }

    if (!isConsent) {
      setError("Please confirm that you agree to the Terms of Service");
      return;
    }

    // Show loading state
    setIsSubmitting(true);

    // Simulate API call - in a real app this would be an actual API call
    setTimeout(() => {
      router.push("/scanning");
    }, 1500);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 to-pink-50">
      {/* Animated background elements */}
      <div className="absolute top-40 left-1/4 w-64 h-64 bg-purple-300/20 rounded-full blur-3xl animate-float"></div>
      <div className="absolute bottom-20 right-1/4 w-96 h-96 bg-pink-300/20 rounded-full blur-3xl animate-float" style={{ animationDelay: '2s' }}></div>
      
      <div className="container mx-auto px-4 py-24">
        <motion.div 
          className="max-w-3xl mx-auto"
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.5 }}
        >
          {/* Header with navigation */}
          <div className="mb-8 flex items-center">
            <Link href="/" className="flex items-center text-purple-600 hover:text-purple-800 transition-colors">
              <ArrowLeft className="h-4 w-4 mr-2" />
              Back to Home
            </Link>
            <div className="ml-auto flex items-center space-x-4">
              <Badge variant="outline" className="bg-purple-500/5 border-purple-200 text-purple-700">
                <Shield className="h-3 w-3 mr-1" />
                AI-Powered
              </Badge>
              <Badge variant="outline" className="bg-pink-500/5 border-pink-200 text-pink-600">
                <Lock className="h-3 w-3 mr-1" />
                Private & Secure
              </Badge>
            </div>
          </div>
          
          {/* Title and description */}
          <motion.div 
            className="mb-8"
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.5 }}
          >
            <h1 className="text-3xl md:text-4xl font-bold mb-2 bg-gradient-to-r from-purple-700 to-pink-600 text-transparent bg-clip-text">Start Your Profile Scan</h1>
            <p className="text-purple-700">
              Our AI analyzes public data to assess safety risks and authenticity.
            </p>
          </motion.div>

          {/* Main card with form */}
          <Card className="p-8 shadow-xl border-purple-200 overflow-hidden relative bg-white/80 backdrop-blur-sm">
            {/* Accent circles */}
            <div className="absolute -top-24 -right-24 w-48 h-48 bg-purple-300/20 rounded-full"></div>
            <div className="absolute -bottom-20 -left-20 w-40 h-40 bg-pink-300/20 rounded-full"></div>
            
            <div className="relative z-10">
              {/* Error Message */}
              {error && (
                <motion.div 
                  className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 flex items-center gap-2"
                  initial={{ opacity: 0, height: 0 }}
                  animate={{ opacity: 1, height: 'auto' }}
                >
                  <AlertCircle className="h-5 w-5" />
                  <p>{error}</p>
                </motion.div>
              )}

              {/* Form */}
              <motion.form 
                className="space-y-6" 
                onSubmit={handleSubmit}
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                transition={{ delay: 0.2 }}
              >
                {/* Name/Handle */}
                <div className="space-y-2">
                  <label htmlFor="nameHandle" className="block text-sm font-medium">
                    Name or Username <span className="text-red-500">*</span>
                  </label>
                  <div className="relative">
                    <User className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                    <Input
                      id="nameHandle"
                      placeholder="Enter name or username"
                      className="pl-10"
                      value={name}
                      onChange={(e) => setName(e.target.value)}
                      required
                    />
                  </div>
                  <p className="text-xs text-muted-foreground">
                    Full name or online handle of the person you want to analyze
                  </p>
                </div>

                {/* Profile Link */}
                <div className="space-y-2">
                  <label htmlFor="profileLink" className="block text-sm font-medium">
                    Profile Link (optional)
                  </label>
                  <div className="relative">
                    <Link2 className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                    <Input
                      id="profileLink"
                      placeholder="https://"
                      className="pl-10"
                      value={link}
                      onChange={(e) => setLink(e.target.value)}
                    />
                  </div>
                  <p className="text-xs text-muted-foreground">
                    Link to any social profile of the person
                  </p>
                </div>

                {/* Platform Selection */}
                <div className="space-y-2">
                  <label htmlFor="platform" className="block text-sm font-medium">
                    Platform
                  </label>
                  <div className="relative">
                    <Globe className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                    <select 
                      id="platform" 
                      className="w-full h-10 pl-10 rounded-md border border-input bg-background ring-offset-background text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                      value={platform}
                      onChange={(e) => setPlatform(e.target.value)}
                    >
                      <option value="">Select platform (or All)</option>
                      <option value="twitter">Twitter/X</option>
                      <option value="instagram">Instagram</option>
                      <option value="facebook">Facebook</option>
                      <option value="linkedin">LinkedIn</option>
                      <option value="reddit">Reddit</option>
                      <option value="tiktok">TikTok</option>
                      <option value="all">All Platforms</option>
                    </select>
                  </div>
                  <p className="text-xs text-muted-foreground">
                    Select which platform to focus on or choose "All Platforms"
                  </p>
                </div>

                {/* Photo Upload */}
                <div className="space-y-2">
                  <label htmlFor="photo" className="block text-sm font-medium">
                    Photo Upload (optional)
                  </label>
                  <div className="border-2 border-dashed border-border hover:border-primary/50 transition-colors rounded-lg p-6 text-center cursor-pointer">
                    <div className="flex flex-col items-center">
                      <Upload className="h-8 w-8 text-muted-foreground mb-3" />
                      <p className="mb-2 text-sm">Drag and drop a photo or</p>
                      <Button variant="outline" size="sm" type="button">
                        Browse Files
                      </Button>
                    </div>
                  </div>
                  <p className="text-xs text-muted-foreground">
                    Accepted formats: JPG, PNG. Max size: 5MB
                  </p>
                </div>

                {/* Privacy Info */}
                <Card className="p-4 bg-accent/5 border border-accent/20 mt-6">
                  <div className="flex items-start gap-3">
                    <Lock className="h-5 w-5 text-accent mt-0.5 flex-shrink-0" />
                    <div>
                      <h3 className="font-medium text-sm mb-1">Privacy Guaranteed</h3>
                      <p className="text-xs text-muted-foreground leading-relaxed">
                        TrueSight only analyzes publicly available information. No private messages or data behind login screens are accessed.
                        All information is processed securely and your search is not shared with the profile owner.
                      </p>
                    </div>
                  </div>
                </Card>

                {/* Consent Checkbox */}
                <div className="flex items-start space-x-3 pt-3">
                  <input 
                    id="consent" 
                    type="checkbox" 
                    className="h-4 w-4 mt-1 border border-input rounded bg-background"
                    checked={isConsent}
                    onChange={(e) => setIsConsent(e.target.checked)}
                    required
                  />
                  <label htmlFor="consent" className="text-sm">
                    I confirm that this scan uses only publicly available data and complies with
                    <Link href="/terms" className="text-primary hover:underline ml-1">
                      Terms of Service
                    </Link>.
                  </label>
                </div>

                {/* Action Buttons */}
                <div className="flex flex-col sm:flex-row gap-3 pt-6">
                  <Button 
                    className="flex-1 bg-gradient-to-r from-purple-600 to-pink-500 hover:from-purple-700 hover:to-pink-600 text-white" 
                    type="submit"
                    disabled={isSubmitting}
                  >
                    {isSubmitting ? (
                      <>
                        <Loader2 className="mr-2 h-4 w-4 animate-spin" />
                        Preparing Scan...
                      </>
                    ) : (
                      <>
                        <Search className="mr-2 h-4 w-4" />
                        Run Scan
                      </>
                    )}
                  </Button>
                  <Button variant="outline" type="button" className="flex-1 border-purple-300 text-purple-700 hover:bg-purple-50" disabled={isSubmitting}>
                    Cancel
                  </Button>
                </div>
              </motion.form>
              
              {/* Scan Features */}
              <motion.div 
                className="grid grid-cols-2 gap-3 mt-8 pt-8 border-t border-purple-100"
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.4 }}
              >
                <div className="flex items-center gap-2">
                  <CheckCircle className="h-4 w-4 text-purple-600" />
                  <span className="text-xs text-purple-800">Identity Verification</span>
                </div>
                <div className="flex items-center gap-2">
                  <CheckCircle className="h-4 w-4 text-purple-600" />
                  <span className="text-xs text-purple-800">Risk Assessment</span>
                </div>
                <div className="flex items-center gap-2">
                  <CheckCircle className="h-4 w-4 text-purple-600" />
                  <span className="text-xs text-purple-800">Sentiment Analysis</span>
                </div>
                <div className="flex items-center gap-2">
                  <CheckCircle className="h-4 w-4 text-purple-600" />
                  <span className="text-xs text-purple-800">Red Flag Detection</span>
                </div>
              </motion.div>
            </div>
          </Card>
        </motion.div>
      </div>
    </div>
  );
}
